# android/keystore.properties için şablon — gerçek dosya git'e commit edilmez (bkz. .gitignore).
#
# Yeni bir release keystore üretmek için (ör. takım arkadaşının makinesinde):
#   cd android/app
#   keytool -genkeypair -v -storetype PKCS12 -keystore nabiz-release.keystore \
#     -alias nabiz-release -keyalg RSA -keysize 2048 -validity 10000
#
# Sonra bu dosyayı android/keystore.properties olarak kopyalayıp gerçek şifreleri girin.
# Bu dosya olmadan `./gradlew assembleRelease` / `bundleRelease` hata verip build'i durdurur —
# release imzasının sessizce debug.keystore'a düşmesini önlemek kasıtlı (bkz. app/build.gradle).

storeFile=nabiz-release.keystore
storePassword=CHANGE_ME
keyAlias=nabiz-release
keyPassword=CHANGE_ME
